# =============================================================
#  Asistente WhatsApp — Consultorio Dr. José Guadalupe Padilla
#  Copiar a .env y completar. NUNCA subir .env al repositorio.
# =============================================================

ENTORNO=desarrollo                 # desarrollo | produccion
ZONA_HORARIA=America/Mexico_City

# --- Base de datos -------------------------------------------
# Desarrollo: SQLite. Producción: postgresql+psycopg://usuario:clave@host/basededatos
DATABASE_URL=sqlite:///./datos/consultorio.db

# --- WhatsApp Cloud API (Meta) -------------------------------
# Durante el desarrollo se usa el NÚMERO DE PRUEBA que da Meta.
# El número real del consultorio se migra al final (día 14).
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_TOKEN=                          # token del usuario del sistema, NO personal
WA_APP_SECRET=                     # para validar la firma X-Hub-Signature-256
WA_VERIFY_TOKEN=cambiar-esto       # el que se registra en el webhook de Meta
WA_API_VERSION=v21.0

# --- OpenAI ---------------------------------------------------
# SIN ESTA CLAVE NO HAY CONVERSACIÓN NATURAL. El sistema sigue
# funcionando, pero solo con los flujos: contesta bien lo previsto y
# repite la misma respuesta ante cualquier otra forma de preguntar.
# Es la diferencia entre un asistente y un catálogo de respuestas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Tope duro de gasto mensual en USD. Al alcanzarlo el sistema
# cae solo a MODO_BASICO y avisa al consultorio.
IA_LIMITE_MENSUAL_USD=15.00

# --- Modo del asistente ---------------------------------------
# basico  = solo flujos, costo cero
# hibrido = flujos + IA solo para lo no previsto  (recomendado)
# ia      = IA en todas las respuestas
MODO_ASISTENTE=hibrido

# --- Agenda ---------------------------------------------------
# Valor inicial. Después manda el interruptor del panel, que el
# consultorio cambia sin tocar nada de esto.
#
# franjas  = ACTIVO. El consultorio reserva franjas en Doctoralia y el
#            asistente agenda solo dentro de ellas. Sin choques posibles.
# google   = LISTO Y EN PAUSA. Lectura y escritura reales. Se activa el día
#            que el consultorio decida dejar Doctoralia.
# calendar = lectura de iCal (Doctoralia no lo ofrece — ver docs/)
# api      = descartado: Doctoralia confirmó que no hay API (MX-03213156)
AGENDA_PROVEEDOR=franjas
DOCTORALIA_API_BASE=
DOCTORALIA_API_KEY=
DOCTORALIA_ICAL_URLS=              # una URL por sede, separadas por coma

# --- Google Calendar (Plan C) ---------------------------------
# Se conecta con una cuenta de servicio: el consultorio comparte su agenda
# con ese correo y le da permiso de «hacer cambios en los eventos». No hay
# que iniciar sesión con la cuenta personal del doctor ni renovar nada.
# Paso a paso en docs/google-calendar.md
#
# El JSON completo de la cuenta de servicio, o la ruta a ese archivo.
GOOGLE_CUENTA_SERVICIO_JSON=
# Agenda por defecto. Cada sede puede tener la suya desde el panel.
GOOGLE_CALENDARIO_ID=
GOOGLE_ZONA_HORARIA=               # vacío → la del consultorio

# Minutos de traslado que se bloquean entre citas de sedes distintas
MINUTOS_TRASLADO_ENTRE_SEDES=45

# --- Avisos de intervención humana ----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=                 # separados por coma
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_AVISOS=                     # separados por coma

# Avisos push al celular (el panel agregado a la pantalla de inicio).
# Generar una sola vez:  python -m scripts.generar_claves_vapid
# Sin estas claves el panel no ofrece la opción y los avisos siguen
# saliendo por Telegram y correo.
VAPID_CLAVE_PUBLICA=
VAPID_CLAVE_PRIVADA=               # credencial: nunca en el repositorio
VAPID_CONTACTO=mailto:soporte@consultorio.local

# --- Panel ----------------------------------------------------
PANEL_SECRETO=cambiar-esto-por-algo-largo-y-aleatorio
PANEL_URL_PUBLICA=http://localhost:8000

# --- Retención de datos ---------------------------------------
# Los historiales de conversación se eliminan al cumplirse este plazo.
RETENCION_CONVERSACIONES_DIAS=365
